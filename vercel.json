{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix alt/node-prototype --omit=dev",
  "buildCommand": "rm -rf dist && mkdir dist && cp -R frontend/. dist/ && cp -R frontend dist/final && cp -R alt/node-prototype/public dist/prototype",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "alt/node-prototype/{checklists,samples}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
