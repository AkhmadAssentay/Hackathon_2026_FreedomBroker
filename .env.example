# Organizer API (GET with group_id). Copy the link from the Student Guide, put {group_id} where the value goes.
CQA_API_URL_TEMPLATE=https://<organizer-endpoint>/invoke?api-version=1&...&group_id={group_id}

# Claude API (main judge). Hard spending cap enforced in code (USD, all calls of this app).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_BUDGET_USD=4.50

# Local judge: vLLM OpenAI-compatible server (HPC via SSH tunnel), see hpc/vllm_serve.sbatch
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=local-judge

# Which provider evaluates by default: claude | local
DEFAULT_PROVIDER=claude
