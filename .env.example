# Copy to .env and fill in ONE provider. Without any LLM the app runs in heuristic mode.
# Local Qwen through Ollama (free): LLM_PROVIDER=openai, LLM_MODEL=qwen2.5:7b,
#   OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama, EVAL_CONCURRENCY=1, LLM_TIMEOUT_MS=300000

# anthropic | openai | gemini | rules   (auto-detected from the key if empty)
LLM_PROVIDER=
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint (e.g. local Ollama/vLLM)
GEMINI_API_KEY=

# USD per 1M tokens of the chosen model — used to show the cost of one evaluation
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

PORT=3000
EVAL_CONCURRENCY=4
# Per-call timeout; raise for slow local models
LLM_TIMEOUT_MS=120000
# Organizers' API (group_id is appended automatically). Default = link from the student guide.
# ORG_API_URL=
